{
  "name": "apaya",
  "version": "1.0.0",
  "description": "Asisten harian pribadi yang menyimpan jurnal secara lokal.",
  "type": "commonjs",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env ELECTRON_START_URL=http://127.0.0.1:5173 electron .\"",
    "build": "vite build",
    "start": "npm run build && electron .",
    "test": "node --test"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^45.2.3",
    "vite": "^6.4.1",
    "wait-on": "^8.0.4"
  }
}
